                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer YOUR_TOKEN_HERE"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost/api/reports/stats",
                            "protocol": "http",
                            "host": ["localhost"],
                            "path": ["api", "reports", "stats"]
                        }
                    }
                }
            ]
        }
    ]
}
